APP_NAME=estate-grid
NODE_ENV=development
PORT=4000
SERVER_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
RENTER_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/estate-grid

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_DEV=estate-grid-postgres-dev
POSTGRES_CONTAINER_PROD=estate-grid-postgres-prod
POSTGRES_PORT=5432
POSTGRES_HOST_PORT_DEV=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_DEV=estate-grid
POSTGRES_DB_PROD=estate-grid
POSTGRES_VOLUME_DEV=estate-grid-postgres-data-dev
POSTGRES_VOLUME_PROD=estate-grid-postgres-data-prod

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=estate-grid:
REDIS_CONNECT_TIMEOUT_MS=10000
PROPERTY_SEARCH_CACHE_TTL_SECONDS=60
PROPERTY_VIEW_DEBOUNCE_TTL_SECONDS=86400
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_DEV=estate-grid-redis-dev
REDIS_CONTAINER_PROD=estate-grid-redis-prod
REDIS_PORT=6379
REDIS_HOST_PORT_DEV=6380
REDIS_VOLUME_DEV=estate-grid-redis-data-dev
REDIS_VOLUME_PROD=estate-grid-redis-data-prod

SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=estate-grid
ELASTICSEARCH_PROPERTY_INDEX=properties
ELASTICSEARCH_REQUEST_TIMEOUT_MS=10000
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.3
ELASTICSEARCH_CONTAINER_DEV=estate-grid-elasticsearch-dev
ELASTICSEARCH_CONTAINER_PROD=estate-grid-elasticsearch-prod
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_VOLUME_DEV=estate-grid-elasticsearch-data-dev
ELASTICSEARCH_VOLUME_PROD=estate-grid-elasticsearch-data-prod
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.15.3
KIBANA_CONTAINER_DEV=estate-grid-kibana-dev
KIBANA_CONTAINER_PROD=estate-grid-kibana-prod
KIBANA_PORT=5601

STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_UPLOAD_URL_TTL_SECONDS=900

QUEUE_DRIVER=memory
QUEUE_NAME=estate-grid-server
QUEUE_RETRY_ATTEMPTS=3
QUEUE_BACKOFF_STRATEGY=exponential
QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_POLL_INTERVAL_MS=500
QUEUE_WORKER_CONCURRENCY=5
PROPERTY_EXPIRY_JOB_INTERVAL_MS=86400000
LISTING_BOOST_EXPIRY_JOB_INTERVAL_MS=86400000
SAVED_SEARCH_ALERT_JOB_INTERVAL_MS=21600000

MAIL_PROVIDER=mailhog
MAILHOG_HOST=localhost
MAILHOG_PORT=1026
MAILHOG_SECURE=false
MAILHOG_USER=
MAILHOG_PASS=
MAILHOG_FROM=estate-grid <no-reply@estate-grid.local>
MAILHOG_IMAGE=mailhog/mailhog:v1.0.1
MAILHOG_CONTAINER_DEV=estate-grid-mailhog-dev
MAILHOG_SMTP_PORT=1026
MAILHOG_HOST_SMTP_PORT=1026
MAILHOG_WEB_PORT=8026
MAILHOG_HOST_WEB_PORT=8026
RESEND_API_KEY=
RESEND_FROM=

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_PROCESS_URL=
PAYFAST_VALIDATE_URL=

APP_NETWORK=estate-grid-network
